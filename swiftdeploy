def append_history(entry):
    entry["ts"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
    with open(HISTORY_FILE, "a", encoding='utf-8') as f:
        f.write(json.dumps(entry) + "\n")

