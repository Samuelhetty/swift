def render_templates(ctx):
    env = Environment(keep_trailing_newline=True)
    os.makedirs(TEMPLATES, exist_ok=True)
    os.makedirs(POLICIES_DIR, exist_ok=True)

    # Keep healthcheck.py current
    with open(os.path.join(ROOT, "app", "healthcheck.py"), "w", encoding='utf-8') as f:
        f.write(HEALTHCHECK_SRC)

    # Sync template files on disk
    for fname, src in [("docker-compose.yml.j2", COMPOSE_TEMPLATE),
                       ("nginx.conf.j2",          NGINX_TEMPLATE)]:
        with open(os.path.join(TEMPLATES, fname), "w", encoding='utf-8') as f:
            f.write(src)

    # Always write policy files so policies/ is never empty
    for fname, src in [
        ("infra.rego",       INFRA_REGO),
        ("canary.rego",      CANARY_REGO),
        ("infra_data.json",  INFRA_DATA),
        ("canary_data.json", CANARY_DATA),
    ]:
        with open(os.path.join(POLICIES_DIR, fname), "w", encoding='utf-8') as f:
            f.write(src)

    # Write configs
    for outpath, tmpl_src in [(NGINX_CONF, NGINX_TEMPLATE), (COMPOSE_FILE, COMPOSE_TEMPLATE)]:
        rendered = env.from_string(tmpl_src).render(**ctx)
        with open(outpath, "w", encoding='utf-8') as f:
            f.write(rendered)
        # Verify
        with open(outpath, encoding='utf-8') as f:
            if f.read() != rendered:
                raise RuntimeError(f"Write verification failed: {outpath}")

