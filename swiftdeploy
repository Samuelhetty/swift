def get_host_stats():
    stats = {}
    # Disk free GB on ROOT partition
    try:
        usage = shutil.disk_usage(ROOT)
        stats["disk_free_gb"]  = round(usage.free / (1024**3), 2)
        stats["disk_total_gb"] = round(usage.total / (1024**3), 2)
    except Exception:
        stats["disk_free_gb"]  = 999.0
        stats["disk_total_gb"] = 999.0

    # CPU load (1-min average)
    try:
        load = os.getloadavg()[0]
        stats["cpu_load"] = round(load, 3)
    except AttributeError:
        # Windows doesn't have getloadavg
        try:
            result = subprocess.run(
                ["wmic", "cpu", "get", "loadpercentage", "/value"],
                capture_output=True, text=True, timeout=5
            )
            match = re.search(r"LoadPercentage=(\d+)", result.stdout)
            stats["cpu_load"] = round(int(match.group(1)) / 100.0, 3) if match else 0.5
        except Exception:
            stats["cpu_load"] = 0.5

    # Memory free percent
    try:
        import ctypes
        class MEMSTATUS(ctypes.Structure):
            _fields_ = [("dwLength", ctypes.c_ulong),
                        ("dwMemoryLoad", ctypes.c_ulong),
                        ("ullTotalPhys", ctypes.c_ulonglong),
                        ("ullAvailPhys", ctypes.c_ulonglong),
                        ("ullTotalPageFile", ctypes.c_ulonglong),
                        ("ullAvailPageFile", ctypes.c_ulonglong),
                        ("ullTotalVirtual", ctypes.c_ulonglong),
                        ("ullAvailVirtual", ctypes.c_ulonglong),
                        ("ullAvailExtendedVirtual", ctypes.c_ulonglong)]
        ms = MEMSTATUS()
        ms.dwLength = ctypes.sizeof(MEMSTATUS)
        ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(ms))
        stats["mem_free_percent"] = round(ms.ullAvailPhys / ms.ullTotalPhys * 100, 2)
    except Exception:
        try:
            with open("/proc/meminfo") as f:
                lines = f.readlines()
            mem = {l.split()[0].rstrip(":"): int(l.split()[1]) for l in lines if l.split()}
            total = mem.get("MemTotal", 1)
            avail = mem.get("MemAvailable", mem.get("MemFree", total))
            stats["mem_free_percent"] = round(avail / total * 100, 2)
        except Exception:
            stats["mem_free_percent"] = 50.0

    return stats

# ============================================================ #
#  Metrics scraping / P99 calculation                          #
# ============================================================ #
def scrape_metrics(port):
    """Fetch raw Prometheus text from /metrics via nginx port."""
    url = f"http://localhost:{port}/metrics"
    try:
        with _ur.urlopen(url, timeout=5) as r:
            return r.read().decode()
    except Exception as e:
        raise RuntimeError(f"Cannot scrape /metrics: {e}") from e

def parse_metrics(text):
    """Parse Prometheus text format into a dict of metric -> list of (labels, value)."""
    result = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r'^([a-zA-Z_:][a-zA-Z0-9_:]*)\{([^}]*)\}\s+([\d.+Infe-]+)$', line)
        if not m:
            m2 = re.match(r'^([a-zA-Z_:][a-zA-Z0-9_:]*)\s+([\d.+Infe-]+)$', line)
            if m2:
                name, val = m2.group(1), float(m2.group(2))
                result.setdefault(name, []).append(({}, val))
            continue
        name   = m.group(1)
        labels = dict(re.findall(r'(\w+)="([^"]*)"', m.group(2)))
        val    = m.group(3)
        try:
            val = float(val)
        except ValueError:
            continue
        result.setdefault(name, []).append((labels, val))
    return result

def calc_error_rate(metrics):
    """Return (error_rate_percent, total_requests, error_requests)."""
    counts = metrics.get("http_requests_total", [])
    total  = sum(v for l, v in counts
                 if l.get("path") not in ("/metrics", "/healthz"))
    errors = sum(v for l, v in counts
                 if l.get("status_code", "").startswith("5")
                 and l.get("path") not in ("/metrics", "/healthz"))
    rate   = (errors / total * 100) if total > 0 else 0.0
    return round(rate, 4), int(total), int(errors)

def calc_p99(metrics, path="/"):
    """
    Estimate P99 latency in ms using histogram linear interpolation.
    Uses all non-infra paths if path is not specified.
    """
    buckets_raw = metrics.get("http_request_duration_seconds_bucket", [])
    # Aggregate across paths (exclude /metrics, /healthz)
    agg = {}
    for labels, val in buckets_raw:
        if labels.get("path") in ("/metrics", "/healthz"):
            continue
        le = labels.get("le", "+Inf")
        agg[le] = agg.get(le, 0) + val

    if not agg:
        return 0.0

    inf_count = agg.get("+Inf", 0)
    if inf_count == 0:
        return 0.0

    target   = 0.99 * inf_count
    BUCKS    = [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0]
    prev_le, prev_count = 0.0, 0.0

    for b in BUCKS:
        count = agg.get(str(b), 0)
        if count >= target:
            # Linear interpolation
            if count == prev_count:
                return round(b * 1000, 2)
            frac = (target - prev_count) / (count - prev_count)
            return round((prev_le + frac * (b - prev_le)) * 1000, 2)
        prev_le, prev_count = b, count

    return round(10.0 * 1000, 2)  # > 10s

