#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
swiftdeploy -- Declarative container deployment CLI
Single source of truth: manifest.yaml
"""

import sys
import os

if sys.stdout.encoding and sys.stdout.encoding.lower() != 'utf-8':
    sys.stdout.reconfigure(encoding='utf-8')
if sys.stderr.encoding and sys.stderr.encoding.lower() != 'utf-8':
    sys.stderr.reconfigure(encoding='utf-8')

import time
import subprocess
import socket
import urllib.request
import urllib.error
import json
import re

try:
    import yaml
except ImportError:
    subprocess.check_call([sys.executable, "-m", "pip", "install", "pyyaml", "-q"])
    import yaml

try:
    from jinja2 import Environment
except ImportError:
    subprocess.check_call([sys.executable, "-m", "pip", "install", "jinja2", "-q"])
    from jinja2 import Environment

ROOT = os.path.dirname(os.path.abspath(__file__))
MANIFEST = os.path.join(ROOT, "manifest.yaml")
TEMPLATES = os.path.join(ROOT, "templates")
NGINX_CONF = os.path.join(ROOT, "nginx.conf")
COMPOSE_FILE = os.path.join(ROOT, "docker-compose.yml")

GREEN  = "\033[92m"
RED    = "\033[91m"
YELLOW = "\033[93m"
CYAN   = "\033[96m"
BOLD   = "\033[1m"
RESET  = "\033[0m"

def ok(msg):   print(f"  {GREEN}[PASS]{RESET}  {msg}")
def fail(msg): print(f"  {RED}[FAIL]{RESET}  {msg}")
def info(msg): print(f"  {CYAN}[INFO]{RESET}  {msg}")
def warn(msg): print(f"  {YELLOW}[WARN]{RESET}  {msg}")
def banner(msg): print(f"\n{BOLD}{msg}{RESET}")

COMPOSE_TEMPLATE = """\
# Generated by swiftdeploy -- do not edit manually
# Source of truth: manifest.yaml

networks:
  {{ network_name }}:
    driver: {{ network_driver }}

volumes:
  {{ log_volume }}:

services:
  app:
    image: {{ service_image }}
    container_name: swiftdeploy-app
    restart: {{ restart_policy }}
    environment:
      MODE: "{{ mode }}"
      APP_VERSION: "{{ version }}"
      APP_PORT: "{{ service_port }}"
    expose:
      - "{{ service_port }}"
    networks:
      - {{ network_name }}
    volumes:
      - {{ log_volume }}:/app/logs
    user: "1000"
    cap_drop:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_PTRACE
      - MKNOD
      - AUDIT_WRITE
      - DAC_OVERRIDE
    healthcheck:
      test: ["CMD", "python3", "/app/healthcheck.py"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s

  nginx:
    image: {{ nginx_image }}
    container_name: swiftdeploy-nginx
    restart: {{ restart_policy }}
    ports:
      - "{{ nginx_port }}:{{ nginx_port }}"
    networks:
      - {{ network_name }}
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ log_volume }}:/var/log/nginx
    depends_on:
      app:
        condition: service_healthy
"""

NGINX_TEMPLATE = """\
# Generated by swiftdeploy -- do not edit manually
# Source of truth: manifest.yaml

log_format swiftdeploy '$time_iso8601 | $status | ${request_time}s | $upstream_addr | $request';

server {
    listen {{ nginx_port }};
    server_name _;

    access_log /var/log/nginx/access.log swiftdeploy;
    error_log  /var/log/nginx/error.log warn;

    proxy_connect_timeout {{ proxy_timeout }}s;
    proxy_send_timeout    {{ proxy_timeout }}s;
    proxy_read_timeout    {{ proxy_timeout }}s;

    add_header X-Deployed-By swiftdeploy always;

    proxy_pass_header X-Mode;

    location / {
        proxy_pass         http://app:{{ service_port }};
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    error_page 502 = @error502;
    error_page 503 = @error503;
    error_page 504 = @error504;

    location @error502 {
        default_type application/json;
        return 502 '{"error":"Bad Gateway","code":502,"service":"{{ service_image }}","contact":"{{ contact }}"}';
    }
    location @error503 {
        default_type application/json;
        return 503 '{"error":"Service Unavailable","code":503,"service":"{{ service_image }}","contact":"{{ contact }}"}';
    }
    location @error504 {
        default_type application/json;
        return 504 '{"error":"Gateway Timeout","code":504,"service":"{{ service_image }}","contact":"{{ contact }}"}';
    }
}
"""

HEALTHCHECK_PY = """\
import urllib.request, sys, os
try:
    port = os.environ.get("APP_PORT", "3000")
    urllib.request.urlopen("http://localhost:" + port + "/healthz", timeout=4)
    sys.exit(0)
except Exception:
    sys.exit(1)
"""

def load_manifest():
    with open(MANIFEST, encoding='utf-8') as f:
        return yaml.safe_load(f)

def save_manifest(data):
    with open(MANIFEST, "w", encoding='utf-8') as f:
        yaml.dump(data, f, default_flow_style=False, sort_keys=False)

def manifest_context(manifest):
    svc   = manifest["services"]
    nginx = manifest["nginx"]
    net   = manifest["network"]
    return {
        "service_image":  svc["image"],
        "service_port":   svc["port"],
        "mode":           svc.get("mode", "stable"),
        "version":        svc.get("version", "1.0.0"),
        "restart_policy": svc.get("restart_policy", "unless-stopped"),
        "log_volume":     svc.get("log_volume", "swiftdeploy-logs"),
        "nginx_image":    nginx["image"],
        "nginx_port":     nginx["port"],
        "proxy_timeout":  nginx.get("proxy_timeout", 30),
        "contact":        nginx.get("contact", "ops@swiftdeploy.io"),
        "network_name":   net["name"],
        "network_driver": net["driver_type"],
    }

def render_templates(ctx):
    env = Environment(keep_trailing_newline=True)

    # Always write healthcheck.py so it exists in the build context
    hc_path = os.path.join(ROOT, "app", "healthcheck.py")
    with open(hc_path, "w", encoding='utf-8') as f:
        f.write(HEALTHCHECK_PY)

    # Sync template files on disk too
    os.makedirs(TEMPLATES, exist_ok=True)
    with open(os.path.join(TEMPLATES, "docker-compose.yml.j2"), "w", encoding='utf-8') as f:
        f.write(COMPOSE_TEMPLATE)
    with open(os.path.join(TEMPLATES, "nginx.conf.j2"), "w", encoding='utf-8') as f:
        f.write(NGINX_TEMPLATE)

    rendered_nginx = env.from_string(NGINX_TEMPLATE).render(**ctx)
    with open(NGINX_CONF, "w", encoding='utf-8') as f:
        f.write(rendered_nginx)

    rendered_compose = env.from_string(COMPOSE_TEMPLATE).render(**ctx)
    with open(COMPOSE_FILE, "w", encoding='utf-8') as f:
        f.write(rendered_compose)

    with open(COMPOSE_FILE, encoding='utf-8') as f:
        on_disk = f.read()
    if on_disk != rendered_compose:
        raise RuntimeError(f"Write verification failed for {COMPOSE_FILE}")

def cmd_init():
    banner("swiftdeploy init")
    manifest = load_manifest()
    ctx = manifest_context(manifest)
    render_templates(ctx)
    ok(f"Generated  nginx.conf        -> {NGINX_CONF}")
    ok(f"Generated  docker-compose.yml -> {COMPOSE_FILE}  (mode={ctx['mode']})")
    info("Run 'swiftdeploy validate' to check pre-flight conditions.")

def cmd_validate():
    banner("swiftdeploy validate")
    errors = 0

    label = "manifest.yaml exists and is valid YAML"
    if not os.path.isfile(MANIFEST):
        fail(label); errors += 1
    else:
        try:
            manifest = load_manifest()
            ok(label)
        except yaml.YAMLError as e:
            fail(f"{label}: {e}"); errors += 1; manifest = None

    if manifest is None:
        sys.exit(errors)

    label = "All required fields are present and non-empty"
    required = {
        "services.image":        manifest.get("services", {}).get("image"),
        "services.port":         manifest.get("services", {}).get("port"),
        "nginx.image":           manifest.get("nginx", {}).get("image"),
        "nginx.port":            manifest.get("nginx", {}).get("port"),
        "network.name":          manifest.get("network", {}).get("name"),
        "network.driver_type":   manifest.get("network", {}).get("driver_type"),
    }
    missing = [k for k, v in required.items() if not v]
    if missing:
        fail(f"{label}: missing {missing}"); errors += 1
    else:
        ok(label)

    label = "Docker image referenced in manifest exists locally"
    image = manifest.get("services", {}).get("image", "")
    try:
        result = subprocess.run(["docker", "image", "inspect", image], capture_output=True)
        if result.returncode != 0:
            fail(f"{label}: '{image}' not found locally"); errors += 1
        else:
            ok(label)
    except FileNotFoundError:
        fail(f"{label}: docker not found on PATH"); errors += 1

    label = "Nginx port is not already bound on the host"
    nginx_port = manifest.get("nginx", {}).get("port", 8080)
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(1)
    result_bind = sock.connect_ex(("127.0.0.1", int(nginx_port)))
    sock.close()
    if result_bind == 0:
        fail(f"{label}: port {nginx_port} is already in use"); errors += 1
    else:
        ok(label)

    label = "Generated nginx.conf is syntactically valid"
    if not os.path.isfile(NGINX_CONF):
        fail(f"{label}: nginx.conf not found -- run 'swiftdeploy init' first"); errors += 1
    else:
        try:
            with open(NGINX_CONF, encoding='utf-8') as _f:
                _conf = _f.read()
            _test_conf = re.sub(r"proxy_pass\s+http://[^:;/\s]+", "proxy_pass http://127.0.0.1", _conf)
            _tmp = NGINX_CONF + ".validate_tmp"
            with open(_tmp, "w", encoding='utf-8') as _f:
                _f.write(_test_conf)
            try:
                result = subprocess.run(
                    ["docker", "run", "--rm",
                     "-v", f"{_tmp}:/etc/nginx/conf.d/default.conf:ro",
                     "nginx:latest", "nginx", "-t", "-q"],
                    capture_output=True, text=True
                )
                if result.returncode != 0:
                    fail(f"{label}:\n    {result.stderr.strip()}"); errors += 1
                else:
                    ok(label)
            finally:
                if os.path.isfile(_tmp):
                    os.remove(_tmp)
        except FileNotFoundError:
            fail(f"{label}: docker not found on PATH"); errors += 1

    print()
    if errors == 0:
        print(f"{GREEN}{BOLD}All checks passed.{RESET}")
    else:
        print(f"{RED}{BOLD}{errors} check(s) failed.{RESET}")
        sys.exit(1)

def compose(*args):
    return subprocess.run(
        ["docker", "compose", "-f", COMPOSE_FILE, *args],
        cwd=ROOT
    )

def wait_healthy(port, timeout=60):
    url = f"http://localhost:{port}/healthz"
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=3) as r:
                if r.status == 200:
                    return True
        except Exception:
            pass
        time.sleep(2)
    return False

def cmd_deploy():
    banner("swiftdeploy deploy")
    for stale in [COMPOSE_FILE, NGINX_CONF]:
        if os.path.isfile(stale):
            os.remove(stale)
            info(f"Removed stale {os.path.basename(stale)}")
    info("Running init ...")
    cmd_init()
    info("Bringing up stack ...")
    compose("up", "-d", "--remove-orphans")
    manifest = load_manifest()
    nginx_port = manifest["nginx"]["port"]
    info(f"Waiting for health checks on port {nginx_port} (timeout 60s) ...")
    if wait_healthy(nginx_port):
        ok("Stack is healthy and ready!")
        info(f"  -> http://localhost:{nginx_port}/")
    else:
        fail("Health check timed out. Check logs: docker compose logs")
        sys.exit(1)

def cmd_promote(target_mode):
    if target_mode not in ("canary", "stable"):
        print(f"{RED}Usage: swiftdeploy promote [canary|stable]{RESET}")
        sys.exit(1)
    banner(f"swiftdeploy promote -> {target_mode}")
    manifest = load_manifest()
    manifest["services"]["mode"] = target_mode
    save_manifest(manifest)
    ok(f"Updated manifest.yaml: mode = {target_mode}")
    ctx = manifest_context(manifest)
    render_templates(ctx)
    ok("Regenerated docker-compose.yml")
    info("Restarting app container ...")
    subprocess.run(
        ["docker", "compose", "-f", COMPOSE_FILE, "up", "-d",
         "--no-deps", "--force-recreate", "app"],
        cwd=ROOT
    )
    nginx_port = manifest["nginx"]["port"]
    info(f"Waiting for service to come back on port {nginx_port} ...")
    if wait_healthy(nginx_port):
        url = f"http://localhost:{nginx_port}/healthz"
        with urllib.request.urlopen(url, timeout=5) as r:
            data = json.loads(r.read())
        ok(f"Mode confirmed: {data.get('mode')} | uptime={data.get('uptime_seconds')}s")
    else:
        fail("Health check timed out after promote.")
        sys.exit(1)

def cmd_teardown(clean=False):
    banner("swiftdeploy teardown")
    if os.path.isfile(COMPOSE_FILE):
        compose("down", "--volumes", "--remove-orphans")
        ok("Containers, networks, and volumes removed.")
    else:
        warn("docker-compose.yml not found -- skipping container teardown.")
    if clean:
        for f in [NGINX_CONF, COMPOSE_FILE]:
            if os.path.isfile(f):
                os.remove(f)
                ok(f"Deleted {os.path.basename(f)}")
        ok("Generated configs cleaned.")

USAGE = f"""
{BOLD}swiftdeploy{RESET} -- declarative container deployment

{CYAN}Usage:{RESET}
  swiftdeploy init
  swiftdeploy validate
  swiftdeploy deploy
  swiftdeploy promote [canary|stable]
  swiftdeploy teardown [--clean]
"""

def main():
    args = sys.argv[1:]
    if not args:
        print(USAGE); sys.exit(0)
    cmd = args[0]
    if cmd == "init":
        cmd_init()
    elif cmd == "validate":
        cmd_validate()
    elif cmd == "deploy":
        cmd_deploy()
    elif cmd == "promote":
        if len(args) < 2:
            print(f"{RED}Usage: swiftdeploy promote [canary|stable]{RESET}")
            sys.exit(1)
        cmd_promote(args[1])
    elif cmd == "teardown":
        cmd_teardown(clean="--clean" in args)
    else:
        print(f"{RED}Unknown command: {cmd}{RESET}")
        print(USAGE)
        sys.exit(1)

if __name__ == "__main__":
    main()
