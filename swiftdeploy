def cmd_init():
    banner("swiftdeploy init")
    manifest = load_manifest()
    ctx      = manifest_context(manifest)
    render_templates(ctx)
    ok(f"Generated  nginx.conf        -> {NGINX_CONF}")
    ok(f"Generated  docker-compose.yml -> {COMPOSE_FILE}  (mode={ctx['mode']})")
    ok(f"Synced     templates/  app/healthcheck.py  and  policies/")
    info("Run 'swiftdeploy validate' to check pre-flight conditions.")


def cmd_validate():
    banner("swiftdeploy validate")
    errors = 0

    label = "manifest.yaml exists and is valid YAML"
    if not os.path.isfile(MANIFEST):
        fail(label); errors += 1; sys.exit(1)
    try:
        manifest = load_manifest(); ok(label)
    except yaml.YAMLError as e:
        fail(f"{label}: {e}"); sys.exit(1)

    label = "All required fields present and non-empty"
    required = {
        "services.image":      manifest.get("services",{}).get("image"),
        "services.port":       manifest.get("services",{}).get("port"),
        "nginx.image":         manifest.get("nginx",{}).get("image"),
        "nginx.port":          manifest.get("nginx",{}).get("port"),
        "network.name":        manifest.get("network",{}).get("name"),
        "network.driver_type": manifest.get("network",{}).get("driver_type"),
    }
    missing = [k for k,v in required.items() if not v]
    if missing: fail(f"{label}: missing {missing}"); errors += 1
    else: ok(label)

    label = "Docker image exists locally"
    image = manifest.get("services",{}).get("image","")
    try:
        r = subprocess.run(["docker","image","inspect",image], capture_output=True)
        if r.returncode != 0: fail(f"{label}: '{image}' not found"); errors += 1
        else: ok(label)
    except FileNotFoundError:
        fail(f"{label}: docker not on PATH"); errors += 1

    label = "Nginx port not already bound"
    nginx_port = manifest.get("nginx",{}).get("port", 8080)
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM); s.settimeout(1)
    bound = s.connect_ex(("127.0.0.1", int(nginx_port))) == 0; s.close()
    if bound: fail(f"{label}: port {nginx_port} in use"); errors += 1
    else: ok(label)

    label = "nginx.conf is syntactically valid"
    if not os.path.isfile(NGINX_CONF):
        fail(f"{label}: run 'swiftdeploy init' first"); errors += 1
    else:
        try:
            with open(NGINX_CONF, encoding='utf-8') as f: conf = f.read()
            test_conf = re.sub(r"proxy_pass\s+http://[^:;/\s]+",
                               "proxy_pass http://127.0.0.1", conf)
            tmp = NGINX_CONF + ".tmp"
            with open(tmp, "w", encoding='utf-8') as f: f.write(test_conf)
            try:
                r = subprocess.run(
                    ["docker","run","--rm",
                     "-v", f"{tmp}:/etc/nginx/conf.d/default.conf:ro",
                     "nginx:latest","nginx","-t","-q"],
                    capture_output=True, text=True)
                if r.returncode != 0: fail(f"{label}: {r.stderr.strip()}"); errors += 1
                else: ok(label)
            finally:
                if os.path.isfile(tmp): os.remove(tmp)
        except FileNotFoundError:
            fail(f"{label}: docker not on PATH"); errors += 1

    print()
    if errors == 0: print(f"{GREEN}{BOLD}All checks passed.{RESET}")
    else: print(f"{RED}{BOLD}{errors} check(s) failed.{RESET}"); sys.exit(1)


def cmd_deploy():
    banner("swiftdeploy deploy")

    # 1. Pre-deploy OPA gate
    info("Running pre-deploy policy checks ...")
    stats = get_host_stats()
    info(f"  Host stats: disk={stats['disk_free_gb']:.1f}GB free  "
         f"cpu_load={stats['cpu_load']:.2f}  "
         f"mem_free={stats['mem_free_percent']:.1f}%")

    domains = [
        ("infra", "swiftdeploy/infra/decision",
         {**stats, "check_type": "pre-deploy"}),
    ]
    passed, results = run_policy_checks(domains, "deploy")
    print_policy_results(results, "deploy")
    append_history({"event": "pre-deploy-check", "passed": passed,
                    "host_stats": stats, "results": results})
    if not passed:
        fail("Deployment blocked by policy. Resolve violations above and retry.")
        sys.exit(1)
    ok("Policy gate passed -- proceeding with deploy")

    # 2. Generate configs
    for stale in [COMPOSE_FILE, NGINX_CONF]:
        if os.path.isfile(stale): os.remove(stale)
    info("Running init ...")
    cmd_init()

    # 3. Bring up stack
    info("Bringing up stack ...")
    compose("up", "-d", "--remove-orphans")

    # 4. Wait for OPA
    info("Waiting for OPA sidecar ...")
    if wait_opa(30):
        ok("OPA is healthy")
    else:
        warn("OPA did not become healthy within 30s -- policy checks will warn")

    # 5. Wait for app health
    nginx_port = load_manifest()["nginx"]["port"]
    info(f"Waiting for service health on port {nginx_port} (timeout 90s) ...")
    if wait_healthy(nginx_port, 90):
        ok("Stack is healthy and ready!")
        info(f"  -> http://localhost:{nginx_port}/")
        append_history({"event": "deploy", "status": "success",
                        "mode": load_manifest()["services"].get("mode","stable")})
    else:
        fail("Health check timed out. Run: docker compose logs")
        append_history({"event": "deploy", "status": "timeout"})
        sys.exit(1)


def cmd_promote(target_mode):
    if target_mode not in ("canary", "stable"):
        print(f"{RED}Usage: swiftdeploy promote [canary|stable]{RESET}"); sys.exit(1)
    banner(f"swiftdeploy promote -> {target_mode}")

    manifest   = load_manifest()
    nginx_port = manifest["nginx"]["port"]
    svc_port   = manifest["services"]["port"]
    current_mode = manifest["services"].get("mode", "stable")

    # Pre-promote check: scrape metrics and query canary domain
    info("Scraping /metrics for pre-promote policy check ...")
    try:
        raw     = scrape_metrics(nginx_port)
        metrics = parse_metrics(raw)
        error_rate, total_reqs, error_reqs = calc_error_rate(metrics)
        p99_ms  = calc_p99(metrics)
        info(f"  Requests: {total_reqs}  Errors: {error_reqs}  "
             f"Error rate: {error_rate:.2f}%  P99: {p99_ms:.0f}ms")

        domains = [
            ("canary", "swiftdeploy/canary/decision", {
                "check_type":         "pre-promote",
                "target_mode":        target_mode,
                "current_mode":       current_mode,
                "error_rate_percent": error_rate,
                "p99_latency_ms":     p99_ms,
                "sample_count":       total_reqs,
            }),
        ]
        passed, results = run_policy_checks(domains, "promote")
        print_policy_results(results, "promote")
        append_history({"event": "pre-promote-check", "passed": passed,
                        "target_mode": target_mode,
                        "metrics": {"error_rate": error_rate, "p99_ms": p99_ms,
                                    "total_reqs": total_reqs},
                        "results": results})
        if not passed:
            fail("Promotion blocked by policy. Resolve violations and retry.")
            sys.exit(1)
        ok("Policy gate passed -- proceeding with promote")

    except RuntimeError as e:
        warn(f"Could not scrape /metrics: {e}")
        warn("Skipping canary policy check (service may be down)")

    # Apply promotion
    manifest["services"]["mode"] = target_mode
    save_manifest(manifest)
    ok(f"Updated manifest.yaml: mode = {target_mode}")

    ctx = manifest_context(manifest)
    render_templates(ctx)
    ok("Regenerated docker-compose.yml")

    info("Restarting app container ...")
    subprocess.run(
        ["docker","compose","-f",COMPOSE_FILE,"up","-d",
         "--no-deps","--force-recreate","app"],
        cwd=ROOT
    )

    info(f"Waiting for service on port {nginx_port} ...")
    if wait_healthy(nginx_port, 60):
        with _ur.urlopen(f"http://localhost:{nginx_port}/healthz", timeout=5) as r:
            data = json.loads(r.read())
        ok(f"Mode confirmed: {data.get('mode')}  uptime={data.get('uptime_seconds')}s")
        append_history({"event": "promote", "status": "success",
                        "mode": target_mode})
    else:
        fail("Health check timed out after promote.")
        append_history({"event": "promote", "status": "timeout", "mode": target_mode})
        sys.exit(1)


def cmd_teardown(clean=False):
    banner("swiftdeploy teardown")
    if os.path.isfile(COMPOSE_FILE):
        compose("down", "--volumes", "--remove-orphans")
        ok("Containers, networks, and volumes removed.")
    else:
        warn("docker-compose.yml not found -- skipping teardown")
    if clean:
        for f in [NGINX_CONF, COMPOSE_FILE]:
            if os.path.isfile(f): os.remove(f); ok(f"Deleted {os.path.basename(f)}")
        ok("Generated configs cleaned.")
    append_history({"event": "teardown", "clean": clean})


def cmd_status():
    """
    Live-refreshing terminal dashboard.
    Scrapes /metrics every 5s, shows req/s, P99, chaos state,
    and per-domain policy compliance. Appends each scrape to history.jsonl.
    Press Ctrl+C to exit.
    """
    banner("swiftdeploy status  (Ctrl+C to exit)")
    manifest   = load_manifest()
    nginx_port = manifest["nginx"]["port"]

    prev_total = None
    prev_ts    = None
    interval   = 5

    while True:
        ts_now = time.time()
        try:
            raw     = scrape_metrics(nginx_port)
            metrics = parse_metrics(raw)
            error_rate, total, errors = calc_error_rate(metrics)
            p99_ms  = calc_p99(metrics)

            # req/s delta
            req_s = 0.0
            if prev_total is not None and prev_ts is not None:
                delta_t = ts_now - prev_ts
                req_s   = max(0, total - prev_total) / delta_t if delta_t > 0 else 0
            prev_total, prev_ts = total, ts_now

            # chaos state
            chaos_vals = metrics.get("chaos_active", [({}, 0)])
            chaos_val  = int(chaos_vals[0][1]) if chaos_vals else 0
            chaos_str  = {0: "none", 1: "slow", 2: "error"}.get(chaos_val, "?")

            # mode
            mode_vals = metrics.get("app_mode", [({}, 0)])
            mode_str  = "canary" if int(mode_vals[0][1]) == 1 else "stable"

            # uptime
            uptime_vals = metrics.get("app_uptime_seconds", [({}, 0)])
            uptime      = int(uptime_vals[0][1]) if uptime_vals else 0

            # OPA policy compliance (non-blocking -- just display)
            policy_lines = []
            try:
                cur_mode    = manifest["services"].get("mode","stable")
                svc_port    = manifest["services"]["port"]
                stats       = get_host_stats()

                domains = [
                    ("infra",  "swiftdeploy/infra/decision",
                     {**stats, "check_type": "status"}),
                    ("canary", "swiftdeploy/canary/decision", {
                        "check_type":         "status",
                        "error_rate_percent": error_rate,
                        "p99_latency_ms":     p99_ms,
                        "sample_count":       total,
                        "current_mode":       cur_mode,
                        "target_mode":        cur_mode,
                    }),
                ]
                _, results = run_policy_checks(domains, "status")
                for r in results:
                    sym  = f"{GREEN}OK{RESET}" if r["passed"] else f"{RED}FAIL{RESET}"
                    note = "" if r["passed"] else f"  [{'; '.join(r['violations'][:1])}]"
                    policy_lines.append(f"    {r['domain']:<12} {sym}{note}")
            except Exception as e:
                policy_lines.append(f"    {YELLOW}OPA unavailable: {e}{RESET}")

            # Print dashboard
            now_str = datetime.datetime.utcnow().strftime("%H:%M:%S UTC")
            print(f"\n{BOLD}{'='*58}{RESET}")
            print(f"  {BOLD}SwiftDeploy Status{RESET}  {DIM}{now_str}{RESET}")
            print(f"  {'Mode':<18} {CYAN}{mode_str}{RESET}")
            print(f"  {'Uptime':<18} {uptime}s")
            print(f"  {'Req/s':<18} {req_s:.2f}")
            print(f"  {'P99 Latency':<18} {p99_ms:.0f}ms")
            print(f"  {'Error Rate':<18} {RED if error_rate>1 else GREEN}{error_rate:.2f}%{RESET}")
            print(f"  {'Chaos':<18} {RED if chaos_str!='none' else GREEN}{chaos_str}{RESET}")
            print(f"  {'Total Requests':<18} {total}")
            print(f"\n  {BOLD}Policy Compliance{RESET}")
            for pl in policy_lines: print(pl)
            print(f"{BOLD}{'='*58}{RESET}")

            # Append to history
            append_history({
                "event":       "status_scrape",
                "mode":        mode_str,
                "uptime_s":    uptime,
                "req_per_s":   round(req_s, 4),
                "p99_ms":      p99_ms,
                "error_rate":  error_rate,
                "chaos":       chaos_str,
                "total_reqs":  total,
            })

        except RuntimeError as e:
            print(f"\n  {RED}[ERR]{RESET} {e}")
            append_history({"event": "status_scrape", "error": str(e)})

        try:
            time.sleep(interval)
        except KeyboardInterrupt:
            print(f"\n{DIM}Status stopped.{RESET}")
            break


def cmd_audit():
    """Generate audit_report.md from history.jsonl."""
    banner("swiftdeploy audit")
    if not os.path.isfile(HISTORY_FILE):
        fail("No history.jsonl found. Run 'swiftdeploy deploy' first."); sys.exit(1)

    entries = []
    with open(HISTORY_FILE, encoding='utf-8') as f:
        for line in f:
            line = line.strip()
            if line:
                try:
                    entries.append(json.loads(line))
                except json.JSONDecodeError:
                    pass

    if not entries:
        fail("history.jsonl is empty."); sys.exit(1)

    lines = ["# SwiftDeploy Audit Report\n",
             f"Generated: {datetime.datetime.utcnow().isoformat()}Z\n",
             f"Total events: {len(entries)}\n\n"]

    # Timeline table
    lines.append("## Event Timeline\n\n")
    lines.append("| Timestamp | Event | Detail |\n")
    lines.append("|-----------|-------|--------|\n")
    lifecycle_events = {"deploy","teardown","promote","pre-deploy-check","pre-promote-check"}
    for e in entries:
        if e.get("event") not in lifecycle_events and e.get("event") != "status_scrape":
            continue
        ts     = e.get("ts","?")
        event  = e.get("event","?")
        if event == "deploy":
            detail = f"status={e.get('status','?')} mode={e.get('mode','?')}"
        elif event == "promote":
            detail = f"mode={e.get('mode','?')} status={e.get('status','?')}"
        elif event == "teardown":
            detail = f"clean={e.get('clean',False)}"
        elif event in ("pre-deploy-check","pre-promote-check"):
            detail = f"passed={e.get('passed','?')}"
        elif event == "status_scrape":
            detail = f"req/s={e.get('req_per_s',0):.2f} p99={e.get('p99_ms',0):.0f}ms error={e.get('error_rate',0):.2f}% chaos={e.get('chaos','?')}"
        else:
            detail = ""
        lines.append(f"| {ts} | {event} | {detail} |\n")

    # Mode changes
    lines.append("\n## Mode Changes\n\n")
    scrapes = [e for e in entries if e.get("event")=="status_scrape"]
    if scrapes:
        lines.append("| Timestamp | Mode | Chaos | Error Rate | P99 (ms) |\n")
        lines.append("|-----------|------|-------|------------|----------|\n")
        prev_mode = None
        for e in scrapes:
            mode = e.get("mode","?")
            if mode != prev_mode:
                lines.append(f"| {e.get('ts','?')} | {mode} | {e.get('chaos','?')} | {e.get('error_rate',0):.2f}% | {e.get('p99_ms',0):.0f} |\n")
                prev_mode = mode
    else:
        lines.append("_No status scrapes recorded._\n")

    # Policy violations
    lines.append("\n## Policy Violations\n\n")
    violations_found = False
    for e in entries:
        if e.get("event") not in ("pre-deploy-check","pre-promote-check"): continue
        for r in e.get("results", []):
            if not r.get("passed") and r.get("violations"):
                violations_found = True
                lines.append(f"**{e.get('ts','?')}** -- `{e.get('event')}` domain=`{r.get('domain')}`\n\n")
                for v in r["violations"]:
                    lines.append(f"- {v}\n")
                lines.append("\n")
    if not violations_found:
        lines.append("_No policy violations recorded._\n")

    # Chaos events
    lines.append("\n## Chaos Events\n\n")
    chaos_events = [e for e in entries
                    if e.get("event")=="status_scrape" and e.get("chaos","none")!="none"]
    if chaos_events:
        lines.append("| Timestamp | Chaos | Error Rate | P99 (ms) |\n")
        lines.append("|-----------|-------|------------|----------|\n")
        for e in chaos_events:
            lines.append(f"| {e.get('ts')} | {e.get('chaos')} | {e.get('error_rate',0):.2f}% | {e.get('p99_ms',0):.0f} |\n")
    else:
        lines.append("_No chaos events recorded._\n")

    report_path = os.path.join(ROOT, "audit_report.md")
    with open(report_path, "w", encoding='utf-8') as f:
        f.writelines(lines)

    ok(f"Audit report written -> {report_path}")
    info(f"  {len(entries)} events  |  "
         f"{len([e for e in entries if e.get('event')=='status_scrape'])} scrapes  |  "
         f"{len(chaos_events)} chaos events")


