OPA_BASE = "http://localhost:8181"

class OPAUnavailableError(Exception): pass
class OPAPolicyError(Exception):      pass

def opa_query(package_path, input_data, timeout=5):
    """
    Query OPA. Tries three methods in order:
      1. HTTP to localhost:8181 (Linux / Docker Desktop with port forwarding)
      2. HTTP to host.docker.internal:8181 (Windows/Mac Docker Desktop fallback)
      3. docker exec into the OPA container (works on any OS)
    Raises OPAUnavailableError if all methods fail.
    Raises OPAPolicyError if the response is malformed.
    Never returns a bare boolean -- always returns the full decision dict.
    """
    payload_str = json.dumps({"input": input_data})
    payload_bytes = payload_str.encode()

    def _parse_response(body_bytes, source):
        body   = json.loads(body_bytes)
        result = body.get("result", {})
        if "decision" not in result:
            raise OPAPolicyError(
                f"OPA response missing 'decision' key ({source}). "
                f"Got: {list(result.keys())}"
            )
        return result["decision"]

    # Method 1 & 2: HTTP (try localhost then host.docker.internal)
    for host in ["localhost", "host.docker.internal"]:
        url = f"http://{host}:8181/v1/data/{package_path}"
        req = _ur.Request(url, data=payload_bytes,
                          headers={"Content-Type": "application/json"},
                          method="POST")
        try:
            with _ur.urlopen(req, timeout=timeout) as r:
                return _parse_response(r.read(), host)
        except (_ue.URLError, OSError):
            continue

    # Method 3: docker exec (works when port forwarding fails on Windows)
    try:
        opa_path = "/" + package_path.replace(".", "/").replace("/decision", "")
        cmd = [
            "docker", "exec", "swiftdeploy-opa",
            "wget", "-qO-",
            "--post-data", payload_str,
            "--header", "Content-Type: application/json",
            f"http://localhost:8181/v1/data/{package_path}",
        ]
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        if result.returncode != 0:
            raise OPAUnavailableError(
                f"docker exec OPA query failed: {result.stderr.strip()}"
            )
        return _parse_response(result.stdout.encode(), "docker-exec")
    except FileNotFoundError:
        raise OPAUnavailableError("docker not found on PATH")
    except subprocess.TimeoutExpired:
        raise OPAUnavailableError("docker exec timed out")
    except OPAPolicyError:
        raise
    except Exception as e:
        raise OPAUnavailableError(f"All OPA query methods failed: {e}") from e

def run_policy_checks(domains_inputs, operation):
    """
    Query each domain independently.
    Returns (all_passed: bool, results: list[dict]).
    Never crashes -- each domain failure is captured and reported.
    """
    results    = []
    all_passed = True

    for domain, pkg_path, input_data in domains_inputs:
        try:
            decision = opa_query(pkg_path, input_data)
            passed   = decision.get("allow", False)
            violations = decision.get("violations", [])
            results.append({
                "domain":     domain,
                "passed":     passed,
                "violations": violations,
                "error":      None,
            })
            if not passed:
                all_passed = False

        except OPAUnavailableError as e:
            warn(f"OPA unavailable for domain '{domain}': {e}")
            warn(f"  -> Treating '{domain}' as WARN (not blocking) -- fix OPA to enforce policy")
            results.append({
                "domain":     domain,
                "passed":     True,   # fail-open with warning when OPA is down
                "violations": [],
                "error":      f"OPA unavailable: {e}",
            })

        except OPAPolicyError as e:
            fail(f"Policy error in domain '{domain}': {e}")
            results.append({
                "domain":     domain,
                "passed":     False,
                "violations": [str(e)],
                "error":      str(e),
            })
            all_passed = False

        except Exception as e:
            fail(f"Unexpected error querying domain '{domain}': {e}")
            results.append({
                "domain":     domain,
                "passed":     False,
                "violations": [f"Unexpected error: {e}"],
                "error":      str(e),
            })
            all_passed = False

    return all_passed, results

def print_policy_results(results, operation):
    print(f"\n  {'Domain':<18} {'Result':<10} Reasoning")
    print(f"  {'-'*18} {'-'*10} {'-'*40}")
    for r in results:
        status = f"{GREEN}ALLOW{RESET}" if r["passed"] else f"{RED}DENY{RESET}"
        if r["error"]:
            status = f"{YELLOW}WARN{RESET}"
        domain = r["domain"]
        if r["violations"]:
            print(f"  {domain:<18} {status:<20}")
            for v in r["violations"]:
                print(f"    {RED}-> {v}{RESET}")
        elif r["error"]:
            print(f"  {domain:<18} {status:<20} {r['error']}")
        else:
            print(f"  {domain:<18} {status:<20} All checks passed")

