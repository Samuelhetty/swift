USAGE = f"""
{BOLD}swiftdeploy{RESET} -- declarative container deployment (Stage 4b)

{CYAN}Usage:{RESET}
  swiftdeploy init
  swiftdeploy validate
  swiftdeploy deploy
  swiftdeploy promote [canary|stable]
  swiftdeploy teardown [--clean]
  swiftdeploy status
  swiftdeploy audit
"""

def main():
    args = sys.argv[1:]
    if not args: print(USAGE); sys.exit(0)
    cmd = args[0]
    if   cmd == "init":     cmd_init()
    elif cmd == "validate": cmd_validate()
    elif cmd == "deploy":   cmd_deploy()
    elif cmd == "promote":
        if len(args) < 2: fail("Usage: swiftdeploy promote [canary|stable]"); sys.exit(1)
        cmd_promote(args[1])
    elif cmd == "teardown": cmd_teardown("--clean" in args)
    elif cmd == "status":   cmd_status()
    elif cmd == "audit":    cmd_audit()
    else:
        fail(f"Unknown command: {cmd}"); print(USAGE); sys.exit(1)

if __name__ == "__main__":
    main()
