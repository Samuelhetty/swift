# Generated by swiftdeploy -- do not edit manually
# Source of truth: manifest.yaml

networks:
  {{ network_name }}:
    driver: {{ network_driver }}

volumes:
  {{ log_volume }}:

services:
  app:
    image: {{ service_image }}
    container_name: swiftdeploy-app
    restart: {{ restart_policy }}
    environment:
      MODE: "{{ mode }}"
      APP_VERSION: "{{ version }}"
      APP_PORT: "{{ service_port }}"
    expose:
      - "{{ service_port }}"
    networks:
      - {{ network_name }}
    volumes:
      - {{ log_volume }}:/app/logs
    user: "1000"
    cap_drop:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_PTRACE
      - MKNOD
      - AUDIT_WRITE
      - DAC_OVERRIDE
    healthcheck:
      test: ["CMD", "python3", "/app/healthcheck.py"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s

  nginx:
    image: {{ nginx_image }}
    container_name: swiftdeploy-nginx
    restart: {{ restart_policy }}
    ports:
      - "{{ nginx_port }}:{{ nginx_port }}"
    networks:
      - {{ network_name }}
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ log_volume }}:/var/log/nginx
    depends_on:
      app:
        condition: service_healthy
